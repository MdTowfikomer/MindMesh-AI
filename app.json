{
  "expo": {
    "name": "MindMesh AI",
    "slug": "mindmesh-ai",
    "version": "0.1.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mindmesh",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mindmesh.ai"
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAF9"
      },
      "package": "com.mindmesh.ai",
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "text/*"
            },
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "*/*"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow MindMesh to record voice memos for AI understanding."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MindMesh to select screenshots for AI analysis."
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MindMesh to capture whiteboards, notes, and visual inspirations."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow MindMesh to access recent photos for visual thought capture.",
          "granularPermissions": ["photo"]
        }
      ]

    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
